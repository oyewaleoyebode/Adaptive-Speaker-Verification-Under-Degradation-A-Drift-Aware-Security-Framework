#recalibration and policy enforcement 

import os
import torch
import numpy as np
import torchaudio
from sklearn.metrics.pairwise import cosine_similarity
from transformers import AutoProcessor, AutoModelForSpeechSeq2Seq, Wav2Vec2ForSequenceClassification
from speechbrain.inference import EncoderClassifier

# Set computation device
device = torch.device("cpu")

# === PATH CONFIGURATION ===
test_audio_path = "VOICE_DEGRADATION/16kh_Converted_VoiceInput copy/speaker_1/audio_5.wav"
reference_embeddings_dir = "/work/oluwatobi-o/Speaker_Identification/Combined_Speakers_embeddings"
baseline_clean_audio_dir = "/work/oluwatobi-o/VOICE_DEGRADATION/16kh_Converted_VoiceInput copy"
wav2vec_path = "/work/oluwatobi-o/VOICE_DEGRADATION/Degradation_Levels_Audio/wav2vec2_degradation_predictor"

# === MODEL LOADING ===
print("🔧 Loading models...")
whisper_model = AutoModelForSpeechSeq2Seq.from_pretrained("openai/whisper-large-v3").to(device).eval()
whisper_processor = AutoProcessor.from_pretrained("openai/whisper-large-v3")
ecapa_model = EncoderClassifier.from_hparams(source="speechbrain/spkrec-ecapa-voxceleb", savedir="tmp_spkrec").to(device).eval()
wav2vec_processor = AutoProcessor.from_pretrained(wav2vec_path)
wav2vec_model = Wav2Vec2ForSequenceClassification.from_pretrained(wav2vec_path).to(device).eval()

# === FUNCTION: Extract ECAPA + Whisper Embedding ===
def extract_combined_embedding(audio_path):
    waveform, sr = torchaudio.load(audio_path)
    if sr != 16000:
        waveform = torchaudio.transforms.Resample(sr, 16000)(waveform)
    waveform = waveform.squeeze()
    waveform = waveform / waveform.abs().max()

    # Whisper embedding
    inputs = whisper_processor(waveform.numpy(), sampling_rate=16000, return_tensors="pt").to(device)
    with torch.no_grad():
        output = whisper_model(**inputs, decoder_input_ids=torch.zeros((1, 1), dtype=torch.long).to(device), output_hidden_states=True)
    whisper_emb = output.encoder_hidden_states[-2].mean(dim=1).squeeze().cpu().numpy()

    # ECAPA embedding
    with torch.no_grad():
        ecapa_emb = ecapa_model.encode_batch(waveform.unsqueeze(0).to(device)).squeeze().cpu().numpy()

    # Normalize and combine
    whisper_emb /= np.linalg.norm(whisper_emb)
    ecapa_emb /= np.linalg.norm(ecapa_emb)
    return np.concatenate((whisper_emb, ecapa_emb))

# === FUNCTION: Predict degradation level (0–2) ===
def predict_degradation(audio_path):
    waveform, sr = torchaudio.load(audio_path)
    if sr != 16000:
        waveform = torchaudio.transforms.Resample(sr, 16000)(waveform)
    waveform = waveform.squeeze()
    inputs = wav2vec_processor(waveform.numpy(), sampling_rate=16000, return_tensors="pt", padding=True).to(device)
    with torch.no_grad():
        logits = wav2vec_model(**inputs).logits
        predicted = torch.argmax(logits, dim=-1).item()
    return predicted

# === FUNCTION: Threshold by degradation level ===
def get_adaptive_threshold(level):
    return {0: 0.64, 1: 0.70, 2: 0.75}.get(level, 0.75)

# === FUNCTION: Load reference embeddings ===
def load_reference_embeddings(path):
    refs = []
    for speaker in os.listdir(path):
        spk_path = os.path.join(path, speaker)
        if os.path.isdir(spk_path):
            for file in os.listdir(spk_path):
                if file.endswith(".npy"):
                    emb = np.load(os.path.join(spk_path, file))
                    emb /= np.linalg.norm(emb)
                    refs.append((speaker.lower(), emb))
    return refs

# === FUNCTION: Get clean baseline similarity for each speaker ===
def compute_baseline_sims(clean_dir, reference_embeddings):
    sims = {}
    for speaker in os.listdir(clean_dir):
        spk_path = os.path.join(clean_dir, speaker)
        if not os.path.isdir(spk_path): continue
        wavs = [f for f in os.listdir(spk_path) if f.endswith(".wav")]
        if not wavs: continue
        test_emb = extract_combined_embedding(os.path.join(spk_path, wavs[0]))
        max_sim = max(cosine_similarity([test_emb], [ref])[0][0]
                      for ref_spk, ref in reference_embeddings if ref_spk == speaker.lower())
        sims[speaker.lower()] = max_sim
    return sims

# === FUNCTION: Decision Logic w/ Policy Enforcement ===
def decide_drift_and_action(score, baseline, threshold, degradation):
    deviation = abs(score - baseline)

    # Drift classification
    if deviation < 0.02:
        drift = "No Drift"
    elif deviation < 0.04:
        drift = "Mild Drift"
    else:
        drift = "High Drift"

    # Decision policy enforcement
    if score >= 0.70 and score >= threshold and degradation == 0 and deviation < 0.02:
        decision = "✅ Accept"
    elif score >= threshold and deviation < 0.04:
        decision = "🟠 Liveness Challenge"
    elif score >= threshold and deviation >= 0.04 and degradation == 0:
        decision = "⚠️ Override Accept (Clean Audio)"
    else:
        decision = "🔴 MFA / Reject"

    return deviation, drift, decision

# === EXECUTION ===
print("🚀 Extracting test embedding...")
test_embedding = extract_combined_embedding(test_audio_path)

print("📉 Predicting degradation...")
predicted_level = predict_degradation(test_audio_path)
adaptive_threshold = get_adaptive_threshold(predicted_level)

print("🧠 Loading reference embeddings...")
reference_embeddings = load_reference_embeddings(reference_embeddings_dir)

print("📊 Calculating baseline similarities...")
baseline_sims = compute_baseline_sims(baseline_clean_audio_dir, reference_embeddings)

# === Speaker Matching ===
similarities = [(speaker, cosine_similarity([test_embedding], [ref])[0][0]) for speaker, ref in reference_embeddings]
similarities.sort(key=lambda x: x[1], reverse=True)
matched_speaker, top_score = similarities[0]

# === Drift & Decision ===
if matched_speaker in baseline_sims:
    deviation, drift_status, final_action = decide_drift_and_action(
        top_score, baseline_sims[matched_speaker], adaptive_threshold, predicted_level
    )
else:
    deviation, drift_status, final_action = None, "Unknown", "⚠️ No Baseline"

# === OUTPUT ===
print("\n📝 FINAL RESULT")
print(f"Test File:              {os.path.basename(test_audio_path)}")
print(f"Matched Speaker:        {matched_speaker}")
print(f"Similarity Score:       {top_score:.4f}")
print(f"Predicted Degradation:  {predicted_level}")
print(f"Adaptive Threshold:     {adaptive_threshold}")
print(f"Deviation from Baseline:{'%.4f' % deviation if deviation is not None else 'N/A'}")
print(f"Drift Status:           {drift_status}")
print(f"Security Decision:      {final_action}")
