#2 DEVIATION ANALYSIS

import os
import torch
import numpy as np
import torchaudio
from tqdm import tqdm
from transformers import AutoProcessor, AutoModelForSpeechSeq2Seq
from speechbrain.inference import EncoderClassifier
from sklearn.metrics.pairwise import cosine_similarity
from sklearn.metrics import roc_curve, auc
from scipy.stats import entropy
import matplotlib.pyplot as plt
import seaborn as sns

# === Degradation Levels ===
degradation_levels = {
    "Baseline": "/work/oluwatobi-o/VOICE_DEGRADATION/16kh_Converted_VoiceInput copy",
    "Level 2": "/work/oluwatobi-o/VOICE_DEGRADATION/Degradation_Levels_Audio/Level_2_Output_fixed",
    "Level 3": "/work/oluwatobi-o/VOICE_DEGRADATION/Degradation_Levels_Audio/Level_3_Output_fixed",
    "Level 4": "/work/oluwatobi-o/VOICE_DEGRADATION/Degradation_Levels_Audio/Level_4_Output_WAV",
    "Level 5": "/work/oluwatobi-o/VOICE_DEGRADATION/Degradation_Levels_Audio/Level_5_Output_WAV"
}

embedding_output_directory = "/work/oluwatobi-o/Speaker_Identification/Combined_Speakers_embeddings"

device = torch.device("cpu")
model_name = "openai/whisper-large-v3"
processor = AutoProcessor.from_pretrained(model_name)
whisper_model = AutoModelForSpeechSeq2Seq.from_pretrained(model_name).to(device)
classifier = EncoderClassifier.from_hparams(source="speechbrain/spkrec-ecapa-voxceleb", savedir="tmp").to(device)
classifier.mods.eval()

def extract_whisper_embedding(audio_path, layer_index=-2):
    try:
        waveform, sr = torchaudio.load(audio_path)
        if sr != 16000:
            waveform = torchaudio.transforms.Resample(sr, 16000)(waveform)
        waveform = waveform.squeeze().cpu().numpy()
        inputs = processor(waveform, sampling_rate=16000, return_tensors="pt").to(device)
        decoder_inputs_embeds = torch.zeros(
            inputs["input_features"].shape[0],
            inputs["input_features"].shape[1],
            whisper_model.config.d_model
        ).to(device)
        with torch.no_grad():
            outputs = whisper_model(**inputs, decoder_inputs_embeds=decoder_inputs_embeds, output_hidden_states=True)
        return outputs.encoder_hidden_states[layer_index].mean(dim=1).squeeze().cpu().numpy()
    except:
        return None

def extract_ecapa_embedding(audio_path):
    try:
        waveform, sr = torchaudio.load(audio_path)
        if sr != 16000:
            waveform = torchaudio.transforms.Resample(sr, 16000)(waveform)
        waveform = waveform.squeeze().unsqueeze(0).to(device)
        with torch.no_grad():
            embedding = classifier.encode_batch(waveform)
        return embedding.squeeze().cpu().numpy()
    except:
        return None

def extract_combined_embeddings(audio_path):
    whisper = extract_whisper_embedding(audio_path)
    ecapa = extract_ecapa_embedding(audio_path)
    if whisper is None or ecapa is None:
        return None
    whisper /= np.linalg.norm(whisper)
    ecapa /= np.linalg.norm(ecapa)
    return np.concatenate((whisper, ecapa))

# Load stored speaker embeddings
print("🔍 Loading stored embeddings...")
stored_embeddings = {}
for speaker_folder in tqdm(os.listdir(embedding_output_directory)):
    speaker_path = os.path.join(embedding_output_directory, speaker_folder)
    if os.path.isdir(speaker_path):
        embeddings = []
        for file in os.listdir(speaker_path):
            if file.endswith(".npy"):
                emb = np.load(os.path.join(speaker_path, file))
                embeddings.append(emb / np.linalg.norm(emb))
        if embeddings:
            avg_emb = np.mean(embeddings, axis=0)
            stored_embeddings[speaker_folder] = avg_emb / np.linalg.norm(avg_emb)

# Deviation Metric Summary
results = {"EER": [], "FAR": [], "FRR": [], "DCF": [], "Level": []}

# Evaluate for each degradation level
for level, test_path in degradation_levels.items():
    print(f"\n🎯 Evaluating: {level}")
    true_labels = []
    pred_scores = []

    for speaker_folder in tqdm(os.listdir(test_path), desc=f"Processing {level}"):
        speaker_path = os.path.join(test_path, speaker_folder)
        if not os.path.isdir(speaker_path): continue

        test_files = sorted([f for f in os.listdir(speaker_path) if f.endswith(".wav")])[:1]
        for f in test_files:
            test_audio = os.path.join(speaker_path, f)
            test_embedding = extract_combined_embeddings(test_audio)
            if test_embedding is None: continue
            test_embedding = test_embedding / np.linalg.norm(test_embedding)

            for ref_speaker, ref_embedding in stored_embeddings.items():
                sim = cosine_similarity([test_embedding], [ref_embedding])[0][0]
                true_labels.append(1 if ref_speaker == speaker_folder else 0)
                pred_scores.append(sim)

    if len(set(true_labels)) < 2:
        print(f"⚠️ Skipping {level} – Not enough data for binary classification.")
        continue

    # Compute metrics
    fpr, tpr, thresholds = roc_curve(true_labels, pred_scores, pos_label=1)
    fnr = 1 - tpr
    eer = fpr[np.nanargmin(np.absolute(fnr - fpr))]
    dcf = 0.5 * fpr[np.nanargmin(np.abs(fnr - fpr))] + 0.5 * fnr[np.nanargmin(np.abs(fnr - fpr))]
    threshold = thresholds[np.nanargmin(np.abs(fnr - fpr))]

    # Binary classification at EER threshold
    predictions = [1 if s >= threshold else 0 for s in pred_scores]
    TP = sum([p == 1 and t == 1 for p, t in zip(predictions, true_labels)])
    FN = sum([p == 0 and t == 1 for p, t in zip(predictions, true_labels)])
    FP = sum([p == 1 and t == 0 for p, t in zip(predictions, true_labels)])
    TN = sum([p == 0 and t == 0 for p, t in zip(predictions, true_labels)])
    FAR = FP / (FP + TN + 1e-6)
    FRR = FN / (FN + TP + 1e-6)

    # Save results
    results["Level"].append(level)
    results["EER"].append(round(eer * 100, 2))
    results["FAR"].append(round(FAR * 100, 2))
    results["FRR"].append(round(FRR * 100, 2))
    results["DCF"].append(round(dcf, 4))

# === Generate Heatmap ===
import pandas as pd
df = pd.DataFrame(results).set_index("Level")
plt.figure(figsize=(10, 6))
sns.heatmap(df.T, annot=True, fmt=".2f", cmap="coolwarm", cbar=True)
plt.title("🎯 Deviation Analysis Heatmap Across Degradation Levels")
plt.ylabel("Metrics")
plt.xlabel("Degradation Level")
plt.tight_layout()
plt.show()
